# GEMINI_API_KEY: Required for Gemini AI API calls in Next.js prototype routes.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_FASTAPI_BASE_URL: Optional URL for the external Python FastAPI ML backend.
# Leave empty to use the built-in Next.js prototype API routes.
NEXT_PUBLIC_FASTAPI_BASE_URL=""
